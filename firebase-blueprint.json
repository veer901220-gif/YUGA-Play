{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "isOnline": { "type": "boolean" },
        "lastActive": { "type": "number" },
        "sessionStart": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Video": {
      "title": "Video",
      "description": "Video information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhotoURL": { "type": "string" }
      },
      "required": ["id", "title", "url", "createdAt", "authorId"]
    },
    "Playlist": {
      "title": "Playlist",
      "description": "Video playlist",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "videoIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" },
        "authorId": { "type": "string" }
      },
      "required": ["id", "title", "videoIds", "createdAt", "authorId"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Application settings",
      "type": "object",
      "properties": {
        "appName": { "type": "string" },
        "appLogo": { "type": "string" },
        "appDetails": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      },
      "required": ["appName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Video metadata"
    },
    "/playlists/{playlistId}": {
      "schema": "Playlist",
      "description": "Video playlists"
    },
    "/settings/config": {
      "schema": "AppSettings",
      "description": "App configuration"
    }
  }
}
