rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - User ID
    //   - email: string (required) - User email
    //   - displayName: string (required) - User display name
    //   - photoURL: string (optional) - User photo URL
    //   - role: string (required, 'admin' | 'user') - User role
    //   - isOnline: boolean (optional) - Online status
    //   - lastActive: number (optional) - Last active timestamp
    //   - sessionStart: number (optional) - Session start timestamp
    //   - createdAt: number (optional) - Creation timestamp
    //
    // Collection: videos
    // Document ID: {videoId}
    // Fields:
    //   - id: string (required) - Video ID
    //   - title: string (required) - Video title
    //   - description: string (optional) - Video description
    //   - url: string (required) - Video URL
    //   - thumbnailUrl: string (optional) - Video thumbnail URL
    //   - createdAt: number (required) - Creation timestamp
    //   - authorId: string (required) - Author ID
    //   - authorName: string (required) - Author name
    //   - authorPhotoURL: string (optional) - Author photo URL
    //
    // Collection: playlists
    // Document ID: {playlistId}
    // Fields:
    //   - id: string (required) - Playlist ID
    //   - title: string (required) - Playlist title
    //   - description: string (optional) - Playlist description
    //   - thumbnailUrl: string (optional) - Playlist thumbnail URL
    //   - videoIds: list (required) - List of video IDs
    //   - createdAt: number (required) - Creation timestamp
    //   - authorId: string (required) - Author ID
    //
    // Collection: settings
    // Document ID: config
    // Fields:
    //   - appName: string (required) - App name
    //   - appLogo: string (optional) - App logo URL
    //   - appDetails: string (optional) - App details
    //   - updatedAt: number (optional) - Last update timestamp
    //   - updatedBy: string (optional) - Last update by name
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "karmveer901220@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.displayName is string &&
             data.role in ['admin', 'user'];
    }

    function isValidVideo(data) {
      return data.keys().hasAll(['id', 'title', 'url', 'createdAt', 'authorId']) &&
             data.id is string &&
             data.title is string && data.title.size() < 200 &&
             data.url is string &&
             data.authorId is string;
    }

    function isValidPlaylist(data) {
      return data.keys().hasAll(['id', 'title', 'videoIds', 'createdAt', 'authorId']) &&
             data.id is string &&
             data.title is string && data.title.size() < 200 &&
             data.videoIds is list &&
             data.authorId is string;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['appName']) &&
             data.appName is string && data.appName.size() < 100;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidVideo(request.resource.data);
      allow update: if isAdmin() && isValidVideo(request.resource.data);
      allow delete: if isAdmin();
    }

    match /playlists/{playlistId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidPlaylist(request.resource.data);
      allow update: if isAdmin() && isValidPlaylist(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/config {
      allow read: if true;
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }
  }
}
